# 本地环境变量与敏感配置
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python 虚拟环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# 前端依赖与构建产物
node_modules/
coverage/
dist-ssr/
*.tsbuildinfo
.eslintcache

# 日志与临时文件
*.log
*.tmp
*.bak
*~

# IDE 与操作系统文件
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
