# 应用
APP_NAME=LabAgent
API_VERSION=/api/v1
SERVER_PORT=8989

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# JWT（生产环境务必替换）
JWT_SECRET_KEY=change-me-in-env
JWT_TTL_SECONDS=86400
JWT_ALGORITHM=HS256

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=labagent
MINIO_SECURE=false

# 模型服务
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=turingdance/gte-large-zh:latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
OPENAI_CHAT_MODEL=ernie-4.5-turbo-128k-preview

# 对话记忆窗口（trim_messages 保留的最大消息条数）
MEMORY_MAX_MESSAGES=20

# 文件上传
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=pdf,md,markdown,txt

# RAG 检索增强
RAG_COLLECTION_NAME=lab_agent_rag
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TERM_FILTER_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_N=5
RAG_RERANK_MODEL=
