# 应用
APP_NAME=LabAgent
API_VERSION=/api/v1
SERVER_PORT=8989

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# JWT（生产环境务必替换）
JWT_SECRET_KEY=change-me-in-env
JWT_TTL_SECONDS=86400
JWT_ALGORITHM=HS256

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=labagent
MINIO_SECURE=false

# 模型服务
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=turingdance/gte-large-zh:latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
OPENAI_CHAT_MODEL=ernie-4.5-turbo-128k-preview

# 对话记忆窗口（trim_messages 保留的最大消息条数）
MEMORY_MAX_MESSAGES=20

# 文件上传
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=pdf,md,markdown,txt

# RAG 检索增强
RAG_COLLECTION_NAME=lab_agent_rag
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TERM_FILTER_ENABLED=true
RAG_QUERY_REWRITE_MODEL=
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_N=5
RAG_RERANK_MODEL=
RAG_RERANK_NUM_PREDICT=64
RAG_RERANK_TIMEOUT_SECONDS=30

# Agent 工具
AGENT_TOOLS_ENABLED=true
FILE_TOOLS_ENABLED=true
SHELL_TOOL_ENABLED=false
SHELL_ALLOWED_ROLES=admin
SHELL_DELETE_REQUIRE_APPROVAL=true
FILE_WRITE_REQUIRE_APPROVAL=false
FILE_MOVE_REQUIRE_APPROVAL=false
FILE_DELETE_REQUIRE_APPROVAL=true
TOOL_WORKSPACE_ROOT=./data/tool-workspaces
TOOL_MAX_READ_CHARS=12000
TOOL_MAX_WRITE_CHARS=24000
TOOL_MAX_SEARCH_RESULTS=50
TOOL_MAX_OUTPUT_CHARS=12000
TOOL_TIMEOUT_SECONDS=60
SHELL_TIMEOUT_SECONDS=20
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_TOOL_ROUNDS=8
TOOL_RUNNER_BASE_URL=http://localhost:8990
# 启用 Shell 时必须配置高强度内部 Token
TOOL_RUNNER_TOKEN=
