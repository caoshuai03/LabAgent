# 应用
APP_NAME=LabAgent
API_VERSION=/api/v1
SERVER_PORT=8989

# Docker 构建依赖源；如内网有 PyPI 镜像，可在 .env 中覆盖
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# Redis + ARQ 知识库异步上传
REDIS_URL=redis://localhost:6379/0
# 接口缓存使用独立 Redis DB，故障时自动回源
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_CACHE_TIMEOUT_SECONDS=1
SKILL_CACHE_TTL_SECONDS=1800
KNOWLEDGE_CACHE_TTL_SECONDS=30
ARQ_QUEUE_NAME=kb_upload
ARQ_JOB_TIMEOUT_SECONDS=1800
ARQ_MAX_JOBS=2

# JWT（生产环境务必替换）
JWT_SECRET_KEY=change-me-in-env
JWT_TTL_SECONDS=86400
JWT_ALGORITHM=HS256

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=labagent
MINIO_SECURE=false

# 模型服务
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URLS=
OLLAMA_RETRY_OTHER_ENDPOINT_ON_FAILURE=false
OLLAMA_CHAT_MODEL=qwen3.5:35b
OLLAMA_EMBEDDING_MODEL=turingdance/gte-large-zh:latest
MODEL_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_TIMEOUT=120
OLLAMA_JUDGE_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
OPENAI_CHAT_MODEL=ernie-4.5-turbo-128k-preview
# 外部模型按 JSON 显式声明上下文窗口；Ollama 模型优先从 /api/ps 读取实际 context_length
MODEL_CONTEXT_WINDOWS={}
# 模型未配置且无法查询实际窗口时使用保守回退值
MODEL_CONTEXT_WINDOW_FALLBACK=32768

# Azure OpenAI 网关（字节 aidp modelhub）
AZURE_API_KEY=
AZURE_API_VERSION=2024-03-01-preview
AZURE_ENDPOINT=https://aidp.bytedance.net/api/modelhub/online/v2/crawl
AZURE_CHAT_MODEL=gpt-5.5-2026-04-24
# X-TT-LOGID，留空则自动生成
AZURE_LOGID=

# 用户级 Markdown 长期记忆目录；会话按当前模型上下文窗口的80%触发自动压缩
MEMORY_ROOT=./data/memory
# 记忆提取最大生成 Token 数；本地模型会显式关闭 reasoning
MEMORY_EXTRACTION_NUM_PREDICT=4096

# 新会话标题生成（失败或超时时保留首条消息截断标题）
CONVERSATION_TITLE_ENABLED=true
CONVERSATION_TITLE_MODEL=
CONVERSATION_TITLE_TIMEOUT_SECONDS=60
CONVERSATION_TITLE_MAX_CHARS=30
CONVERSATION_TITLE_ASSISTANT_CONTEXT_CHARS=500
CONVERSATION_TITLE_NUM_PREDICT=32

# 文件上传
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=pdf,md,markdown,txt
CHAT_IMAGE_MAX_SIZE_MB=10
CHAT_IMAGE_MAX_COUNT=10

# RAG 检索增强
RAG_COLLECTION_NAME=lab_agent_rag
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TERM_FILTER_ENABLED=true
RAG_QUERY_REWRITE_MODEL=
RAG_MULTI_QUERY_COUNT=2
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_N=20
RAG_RERANK_MODEL=
RAG_RERANK_NUM_PREDICT=64
RAG_RERANK_TIMEOUT_SECONDS=30

# Agent 工具
AGENT_TOOLS_ENABLED=true
FILE_TOOLS_ENABLED=true
SHELL_TOOL_ENABLED=false
SHELL_ALLOWED_ROLES=admin
SHELL_DELETE_REQUIRE_APPROVAL=true
FILE_WRITE_REQUIRE_APPROVAL=false
FILE_MOVE_REQUIRE_APPROVAL=false
FILE_DELETE_REQUIRE_APPROVAL=true
TOOL_WORKSPACE_ROOT=./data/tool-workspaces
TOOL_MAX_READ_CHARS=12000
TOOL_MAX_WRITE_CHARS=24000
TOOL_MAX_SEARCH_RESULTS=50
TOOL_MAX_OUTPUT_CHARS=12000
TOOL_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=1200
AGENT_MAX_TOOL_ROUNDS=8
TOOL_RUNNER_BASE_URL=http://localhost:8990
# 启用 Shell 时必须配置高强度内部 Token
TOOL_RUNNER_TOKEN=

# Markdown Skills（只加载 backend/skills 下管理员审核的本地 Skill）
SKILLS_ENABLED=true
SKILLS_DIRECTORY=./skills
SKILLS_MAX_COUNT=50
SKILLS_MAX_ACTIVATIONS_PER_RUN=3
SKILLS_MAX_SKILL_FILE_BYTES=262144
SKILLS_MAX_RESOURCE_FILE_BYTES=262144
SKILLS_RESOURCE_MAX_DEPTH=3
SKILLS_MAX_ACTIVE_CHARS=32000
